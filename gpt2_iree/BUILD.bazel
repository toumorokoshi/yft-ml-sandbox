load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

py_console_script_binary(
    name = "iree_import_onnx",
    pkg = "@pypi//iree_base_compiler",
    script = "iree-import-onnx",
)

py_library(
    name = "tokenizer_lib",
    srcs = ["tokenizer.py"],
    deps = [
        "@pypi//transformers",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "compile_lib",
    srcs = ["compile.py"],
    deps = [
        "@pypi//iree_base_compiler",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "inference_lib",
    srcs = ["inference.py"],
    deps = [
        "@pypi//numpy",
        "@pypi//iree_base_runtime",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "main_lib",
    srcs = [
        "main.py",
        "__init__.py",
    ],
    deps = [
        ":tokenizer_lib",
        ":compile_lib",
        ":inference_lib",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "run",
    srcs = ["main.py"],
    main = "main.py",
    deps = [
        ":main_lib",
    ],
    data = [
        ":iree_import_onnx",
        "@gpt2_onnx//file",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "main_test",
    srcs = ["main_test.py"],
    deps = [
        ":main_lib",
        "@pypi//numpy",
    ],
    data = [
        ":iree_import_onnx",
        "@gpt2_onnx//file",
    ],
)

