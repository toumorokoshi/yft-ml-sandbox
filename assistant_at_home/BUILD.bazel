load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "assistant_at_home",
    srcs = [
        "src/main.rs",
        "src/download.rs",
        "src/transcribe.rs",
        "src/llm.rs",
        "src/audio.rs",
        "src/tts.rs",
    ],
    edition = "2024",
    deps = [
        "@crates//:ort",
        "@crates//:ndarray",
        "@crates//:tokenizers",
        "@crates//:hound",
        "@crates//:ureq",
        "@crates//:clap",
    ],
    data = glob([
        "models/**",
    ]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "assistant_at_home_test",
    crate = ":assistant_at_home",
    data = [
        "beckett.wav",
    ] + glob([
        "models/**",
    ]),
)
