load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "main_lib",
    srcs = ["main.py"],
    deps = [
        "//alexnet_core",
        "//yft_utils",
        "@pypi//asciichartpy",
        "@pypi//onnx",
        "@pypi//onnxscript",
        "@pypi//torch",
        "@pypi//torchvision",
        "@pypi//scipy",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "main",
    srcs = ["main.py"],
    deps = [
        ":main_lib",
    ],
    visibility = ["//visibility:public"],
    env = select({
        "@platforms//os:osx": {
            "PYTORCH_ENABLE_MPS_FALLBACK": "1",
        },
        "@platforms//os:linux": {
            "HSA_OVERRIDE_GFX_VERSION": "11.0.0",
        },
        "//conditions:default": {},
    }),
)

py_test(
    name = "main_test",
    srcs = ["main_test.py"],
    deps = [
        ":main_lib",
        "@pypi//torch",
    ],
)