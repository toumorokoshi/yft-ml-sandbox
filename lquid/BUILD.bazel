load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@rules_python//python:defs.bzl", "py_binary")


rust_binary(
    name = "lquid",
    srcs = [
        "src/main.rs",
        "src/triton_ir.rs",
        "src/onnx_compiler.rs",
    ],

    edition = "2021",

    deps = [
        "//lquid/onnx_reader",
        "@crates//:onnx-protobuf",
        "@crates//:protobuf",
    ],

    visibility = ["//visibility:public"],
)

rust_test(
    name = "lquid_test",
    crate = ":lquid",
)

rust_binary(
    name = "metal",
    srcs = select({
        "@platforms//os:macos": ["src/metal.rs"],
        "//conditions:default": ["src/main_stub.rs"],
    }),
    edition = "2021",
    deps = select({
        "@platforms//os:macos": [
            "@crates//:objc2",
            "@crates//:objc2-foundation",
            "@crates//:objc2-metal",
        ],
        "//conditions:default": [],
    }),
    rustc_flags = select({
        "@platforms//os:macos": [
            "-C", "link-arg=-framework", "-C", "link-arg=Metal",
            "-C", "link-arg=-framework", "-C", "link-arg=CoreGraphics",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

py_binary(
    name = "run_triton_kernel",
    srcs = ["run_triton_kernel.py"],
    main = "run_triton_kernel.py",
    deps = [
        "//onnx_simple_linear:model_lib",
        "@pypi//torch",
    ],
    env = {
        "HSA_OVERRIDE_GFX_VERSION": "11.0.0",
    },
)

