load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "lquid",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [
        "//lquid/onnx_reader",
        "@crates//:onnx-protobuf",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "lquid_test",
    crate = ":lquid",
)

rust_binary(
    name = "metal",
    srcs = select({
        "@platforms//os:macos": ["src/metal.rs"],
        "//conditions:default": ["src/main_stub.rs"],
    }),
    edition = "2021",
    deps = select({
        "@platforms//os:macos": [
            "@crates//:objc2",
            "@crates//:objc2-foundation",
            "@crates//:objc2-metal",
        ],
        "//conditions:default": [],
    }),
    rustc_flags = select({
        "@platforms//os:macos": [
            "-C", "link-arg=-framework", "-C", "link-arg=Metal",
            "-C", "link-arg=-framework", "-C", "link-arg=CoreGraphics",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
