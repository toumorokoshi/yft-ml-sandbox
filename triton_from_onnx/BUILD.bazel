load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

GPU_ENV = select({
    "@platforms//os:osx": {
        "PYTORCH_ENABLE_MPS_FALLBACK": "1",
    },
    "@platforms//os:linux": {
        "HSA_OVERRIDE_GFX_VERSION": "11.0.0",
    },
    "//conditions:default": {},
})

py_library(
    name = "interpreter_lib",
    srcs = ["interpreter.py"],
    deps = [
        "@pypi//onnx",
        "//:torch",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "main",
    srcs = ["main.py"],
    deps = [
        ":interpreter_lib",
        "//yft_utils",
    ],
    env = GPU_ENV,
    visibility = ["//visibility:public"],
)

py_test(
    name = "main_test",
    srcs = ["main_test.py"],
    deps = [
        ":interpreter_lib",
        ":main",
        "//yft_utils",
        "//:torch",
    ],
    env = GPU_ENV,
)

py_binary(
    name = "experiment",
    srcs = ["experiment.py"],
    deps = [
        ":interpreter_lib",
        "//gpu_device_info",
    ],
    env = GPU_ENV,
)

py_binary(
    name = "inspect_ops",
    srcs = ["inspect_ops.py"],
    deps = [
        "@pypi//onnx",
    ],
)

py_binary(
    name = "generate_gemm",
    srcs = ["generate_gemm.py"],
    deps = [
        "@pypi//onnx",
    ],
)
