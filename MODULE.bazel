module(
    name = "yft_ml_sandbox",
    version = "0.1.0",
)

bazel_dep(name = "rules_python", version = "0.36.0")

PYTHON_VERSION = "3.12"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = PYTHON_VERSION,
)
use_repo(python, "python_3_12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    requirements_lock = "//:requirements_lock.txt",
    python_version = PYTHON_VERSION,
    hub_name = "pypi",
    experimental_extra_index_urls = ["https://download.pytorch.org/whl/rocm6.2"],
)
use_repo(pip, "pypi")

bazel_dep(name = "rules_rust", version = "0.70.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.92.0"],
)
use_repo(rust, "rust_toolchains")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "objc2",
    version = "0.6.0",
)
crate.spec(
    package = "objc2-foundation",
    version = "0.3.0",
    features = [
        "std",
        "alloc",
        "NSString",
        "NSArray",
        "NSData",
        "NSError",
        "NSValue",
    ],
)
crate.spec(
    package = "objc2-metal",
    version = "0.3.0",
    features = [
        "std",
        "MTLDevice",
        "MTLCommandQueue",
        "MTLCommandBuffer",
        "MTLComputeCommandEncoder",
        "MTLComputePipeline",
        "MTLBuffer",
        "MTLLibrary",
    ],
)
crate.spec(
    package = "protobuf",
    version = "=3.4.0",
)
crate.spec(
    package = "onnx-protobuf",
    version = "0.2.3",
)
crate.spec(
    package = "ort",
    version = "2.0.0-rc.12",
    features = ["ndarray"],
)
crate.spec(
    package = "ndarray",
    version = "0.17.2",
)
crate.spec(
    package = "tokenizers",
    version = "0.20.0",
)
crate.spec(
    package = "hound",
    version = "3.5.1",
)
crate.spec(
    package = "ureq",
    version = "2.9.6",
)
crate.spec(
    package = "clap",
    version = "4.5.4",
    features = ["derive"],
)
crate.from_specs()
use_repo(crate, "crates")

# HTTP file download for GPT-2 ONNX model
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_file(
    name = "gpt2_onnx",
    sha256 = "12fbb1ec2d2d70c8ebd21a290a348a4109447b98582af64c6f93b6526d5c8f35",
    urls = ["https://github.com/onnx/models/raw/main/validated/text/machine_comprehension/gpt-2/model/gpt2-lm-head-10.onnx"],
)